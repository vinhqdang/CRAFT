\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Six real Snowy Scenes val-split frames run through the corrected checkpoint: three \texttt  {accumulated} (nominal) and three \texttt  {falling} (degraded), each showing the camera image, LiDAR BEV occupancy channel, and the CCP disagreement map $1-S$. Mean disagreement is consistently \emph  {higher} for the visually milder \texttt  {accumulated} frames (category mean $0.590$) than the visually more severe \texttt  {falling} frames (category mean $0.565$) -- the wrong-direction pattern Section~\ref {sec:ccp-negative} diagnoses from the full stream, visible here across six independent real frames rather than only in aggregate statistics or a single pair.}}{46}{figure.2}\protected@file@percent }
\newlabel{fig:qualitative-multi}{{2}{46}{Six real Snowy Scenes val-split frames run through the corrected checkpoint: three \texttt {accumulated} (nominal) and three \texttt {falling} (degraded), each showing the camera image, LiDAR BEV occupancy channel, and the CCP disagreement map $1-S$. Mean disagreement is consistently \emph {higher} for the visually milder \texttt {accumulated} frames (category mean $0.590$) than the visually more severe \texttt {falling} frames (category mean $0.565$) -- the wrong-direction pattern Section~\ref {sec:ccp-negative} diagnoses from the full stream, visible here across six independent real frames rather than only in aggregate statistics or a single pair}{figure.2}{}}
\gdef \@abspage@last{46}
